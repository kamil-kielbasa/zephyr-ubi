 *
 * The internal flash of an nRF5340: 4 KiB pages, 8 bytes per write. The
 * stock simulator writes single bytes, which is a luxury no part offers and
 * which leaves every alignment and padding path in the library dead.
 */

&flash0 {
        erase-block-size = <4096>;
        write-block-size = <8>;
};
