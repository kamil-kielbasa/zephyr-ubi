 *
 * The stock storage partition is four erase blocks, which is the bare
 * minimum UBI accepts and leaves nothing to observe. Widen it to 512 KiB so
 * that a scan has 128 blocks to walk, the same figure the design targets.
 */

&storage_partition {
	reg = <0x000fc000 0x00080000>;
};
