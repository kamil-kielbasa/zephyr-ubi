 *
 * The internal flash of an STM32U585: 8 KiB pages, 16 bytes per write.
 *
 * Sixteen matters on its own. A volume table record is 32 bytes plus 24 per
 * volume, so with anything that divides eight it is aligned by accident and
 * the rounding in ubi_volume_table_write() is never reached.
 */

&flash0 {
        erase-block-size = <8192>;
        write-block-size = <16>;
};
