 *
 * 128 KiB of the MX25R64, 32 blocks: every block has to take its turn under
 * the traffic, and on real flash each turn costs an erase.
 */

&mx25r64 {
	status = "okay";

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		ubi_partition: partition@0 {
			label = "ubi-storage";
			reg = <0x00000000 0x00020000>;
		};
	};
};
