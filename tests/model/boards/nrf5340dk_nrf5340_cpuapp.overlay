 *
 * 256 KiB of the MX25R64, 64 blocks, as the model has on the simulator.
 */

&mx25r64 {
	status = "okay";

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		ubi_partition: partition@0 {
			label = "ubi-storage";
			reg = <0x00000000 0x00040000>;
		};
	};
};
