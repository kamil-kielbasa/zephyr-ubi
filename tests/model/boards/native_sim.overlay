 *
 * 256 KiB, 64 blocks: few enough that the volumes fill the device and every
 * block takes its turn within one run.
 */

/delete-node/ &slot1_partition;
/delete-node/ &scratch_partition;

&flash0 {
	partitions {
		ubi_partition: partition@75000 {
			label = "ubi-storage";
			reg = <0x00075000 0x00040000>;
		};
	};
};
